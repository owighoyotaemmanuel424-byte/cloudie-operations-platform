# Legacy Convex runtime remains enabled until feature-parity cutover is completed.
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=
VITE_CONVEX_URL=

# Turso/libSQL production database (server-side only; NEVER use a VITE_ prefix).
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Legacy PostgreSQL/Neon API and migration path; keep only during staged cutover/rollback.
DATABASE_URL=

# Optional API origin; leave blank for same-origin Vercel Functions.
VITE_API_BASE_URL=

# API security and CORS.
JWT_SECRET=
CORS_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:3000,http://localhost:5173
FRONTEND_URL=https://your-vercel-domain.vercel.app

# Optional provider secret; server-side only.
LOGSPANEL_API_KEY=
