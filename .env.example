# Public frontend configuration. For Freebuff production, VITE_CONVEX_URL is injected by `npx convex deploy --cmd ...`.
VITE_CONVEX_URL=

# Staged Neon API (public URL only; never place database credentials or signing secrets here).
VITE_NEON_API_URL=https://cloudie-operations-api-stage.onrender.com

# Keep disabled until the Vercel gateway and staging cookie flow are verified end to end.
VITE_NEON_API_SAME_ORIGIN=false
VITE_NEON_COOKIE_ONLY=false

# Convex site URL for auth
CONVEX_SITE_URL=https://YOUR_CONVEX_SITE_URL

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Marketplace provider (server-side only)
LOGSPANEL_API_KEY=

# Production Convex deployment authentication (set only in Freebuff/CI secrets; never commit)
# CONVEX_DEPLOY_KEY=
