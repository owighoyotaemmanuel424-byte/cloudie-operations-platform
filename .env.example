# Turso/libSQL production database (server-side only; NEVER use a VITE_ prefix).
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Legacy PostgreSQL/Neon source database; used only by the one-time migration utility.
SOURCE_DATABASE_URL=
DATABASE_URL=

# Optional API origin; leave blank for same-origin Vercel Functions.
VITE_API_BASE_URL=

# API security and CORS.
JWT_SECRET=
CORS_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:3000,http://localhost:5173
FRONTEND_URL=https://your-vercel-domain.vercel.app

# Optional provider secret; server-side only.
LOGSPANEL_API_KEY=

# Email transport for password-reset delivery and campaign sending (server-side only).
# Option 1: managed VLY gateway (preferred).
VLY_INTEGRATION_KEY=
# Option 2: SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Option 3: webhook transport for password-reset tokens only.
PASSWORD_RESET_WEBHOOK_URL=
