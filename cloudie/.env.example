# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-byte-random-secret
JWT_SECRET=replace-with-32-byte-random-secret

# Database and cache
DATABASE_URL=postgresql://cloudie:cloudie_dev_password@localhost:5432/cloudie?schema=public
DIRECT_URL=postgresql://cloudie:cloudie_dev_password@localhost:5432/cloudie?schema=public
REDIS_URL=redis://localhost:6379

# CORS / real-time
WEB_ORIGIN=http://localhost:3000
SOCKET_CORS_ORIGINS=http://localhost:3000

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage (MinIO defaults for local development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cloudie-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# Payments: leave disabled until provider webhooks/signatures are configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRYPTO_PROVIDER=mock-disabled
CRYPTO_PROVIDER_API_KEY=
CRYPTO_WEBHOOK_SECRET=
CRYPTO_DEPOSIT_CONFIRMATIONS=3
PAYMENTS_ENABLED=false

# Email / web push
RESEND_API_KEY=
EMAIL_FROM=Cloudie <no-reply@example.invalid>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid

# Worker / security
BULLMQ_PREFIX=cloudie
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
COMPLIANCE_KEYWORDS=phishing,credential theft,impersonation
ADMIN_SEED_EMAIL=admin@cloudie.dev
ADMIN_SEED_PASSWORD=password
SEED_DEMO_DATA=true
