generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole { USER VENDOR ADMIN }
enum ShipmentStatus { PENDING IN_TRANSIT OUT_FOR_DELIVERY DELIVERED FAILED CANCELLED }
enum WorkspaceType { PERSONAL SHIPMENTS TICKETING BUSINESS SERVICES }
enum TxType { DEPOSIT REFUND CHARGE SUBSCRIPTION_ADJUSTMENT ADMIN_OVERRIDE }
enum VendorStatus { PENDING VERIFIED SUSPENDED }
enum DisputeStatus { OPEN UNDER_REVIEW RESOLVED_REFUND RESOLVED_RELEASE }
enum DepositStatus { PENDING CONFIRMING CONFIRMED FAILED EXPIRED }
enum KycStatus { PENDING APPROVED REJECTED }
enum NotificationStatus { QUEUED SENT FAILED }
enum IdempotencyStatus { PROCESSING COMPLETED FAILED }

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  name               String?
  passwordHash       String
  role               UserRole        @default(USER)
  pointsBalance      Int             @default(0)
  referralCode       String          @unique @default(cuid())
  referredBy         String?
  referralRewardedAt DateTime?
  isSuspended        Boolean         @default(false)
  terminatedAt       DateTime?
  workspaces         Workspace[]
  transactions       PointLedger[]
  shipments          Shipment[]
  subTenants         SubTenantSite[]
  vendorProfile      Vendor?
  cryptoDeposits     CryptoDeposit[]
  idempotencyKeys    IdempotencyKey[]
  kycDocuments       KycDocument[]
  assets             Asset[]
  campaigns          EmailCampaign[]
  notifications      Notification[]
  referralParent     User?           @relation("Referrals", fields: [referredBy], references: [id], onDelete: SetNull)
  referrals          User[]          @relation("Referrals")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  @@index([role])
  @@index([referredBy])
  @@index([isSuspended, terminatedAt])
}

model Workspace {
  id        String        @id @default(uuid())
  userId    String
  type      WorkspaceType
  settings  Json          @default("{}")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@unique([userId, type])
}

model PointLedger {
  id             String   @id @default(uuid())
  userId         String
  amount         Int
  type           TxType
  description    String
  workspace      String
  metadata       Json?
  idempotencyKey String?  @unique
  reversesId     String?  @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  reverses       PointLedger? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     PointLedger? @relation("LedgerReversal")
  createdAt      DateTime @default(now())
  @@index([userId, createdAt])
  @@index([workspace])
  @@index([type])
  @@index([createdAt])
}

model IdempotencyKey {
  id        String           @id @default(uuid())
  userId    String
  key       String
  scope     String
  status    IdempotencyStatus @default(PROCESSING)
  response  Json?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  @@unique([userId, scope, key])
  @@index([status, updatedAt])
}

model Shipment {
  id             String         @id @default(uuid())
  trackingNumber String         @unique
  userId         String
  senderInfo     Json
  recipientInfo  Json
  status         ShipmentStatus @default(PENDING)
  events         ShipmentEvent[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([userId, createdAt])
  @@index([status])
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  status     ShipmentStatus
  location   String?
  note       String?
  occurredAt DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  @@index([shipmentId, occurredAt])
}

model SubTenantSite {
  id          String   @id @default(uuid())
  userId      String
  siteName    String
  subdomain   String   @unique
  siteType    String
  isActive    Boolean  @default(true)
  isLocked    Boolean  @default(false)
  renewalDate DateTime
  branding    Json     @default("{}")
  complianceStatus String @default("PENDING")
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  kycDocuments KycDocument[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
  @@index([isActive, isLocked])
  @@index([renewalDate])
}

model Vendor {
  id            String       @id @default(uuid())
  userId        String       @unique
  businessName  String
  status        VendorStatus @default(PENDING)
  payoutAddress String?
  escrowBalance Int          @default(0)
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  packages      PointPackage[]
  disputes      Dispute[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PointPackage {
  id        String   @id @default(uuid())
  vendorId  String
  name      String
  points    Int
  priceUsd  Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([vendorId, isActive])
}

model Dispute {
  id          String        @id @default(uuid())
  vendorId    String
  buyerUserId String
  amount      Int
  reason      String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  assignedAdminId String?
  vendor      Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([status, createdAt])
  @@index([buyerUserId])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

model CryptoDeposit {
  id            String        @id @default(uuid())
  userId        String
  currency      String
  address       String
  txHash        String?       @unique
  amount        Decimal?      @db.Decimal(18, 8)
  pointsIssued  Int?
  confirmed     Boolean       @default(false)
  status        DepositStatus @default(PENDING)
  providerRef   String?       @unique
  idempotencyKey String?      @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model KycDocument {
  id          String    @id @default(uuid())
  userId      String
  tenantId    String?
  objectKey   String
  fileName    String
  contentType String
  status      KycStatus @default(PENDING)
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant      SubTenantSite? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([status, createdAt])
  @@index([userId])
}

model Asset {
  id          String   @id @default(uuid())
  userId      String
  objectKey   String   @unique
  fileName    String
  contentType String
  sizeBytes   BigInt
  folder      String   @default("/")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, folder])
}

model EmailCampaign {
  id          String   @id @default(uuid())
  userId      String
  name        String
  subject     String
  contentJson Json
  status      String   @default("DRAFT")
  scheduledAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, status])
}

model Notification {
  id          String            @id @default(uuid())
  userId      String
  channel     String
  recipient   String
  subject     String?
  payload     Json
  status      NotificationStatus @default(QUEUED)
  providerRef String?
  error       String?
  sentAt      DateTime?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ComplianceKeyword {
  id        String   @id @default(uuid())
  keyword   String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComplianceFlag {
  id          String   @id @default(uuid())
  targetType  String
  targetId    String
  reason      String
  details     Json?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime @default(now())
  @@index([resolvedAt, createdAt])
  @@index([targetType, targetId])
}
