{
  "name": "cloudie-turso-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/server.smoke.ts",
    "migrate": "node scripts/migrate.mjs",
    "migrate:dry-run": "node scripts/migrate.mjs --dry-run",
    "migrate:turso": "node scripts/migrate-turso.mjs",
    "migrate:turso:dry-run": "node scripts/migrate-turso.mjs --dry-run",
    "migrate:postgres-to-turso": "node scripts/migrate-postgres-to-turso.mjs",
    "migrate:postgres-to-turso:apply": "node scripts/migrate-postgres-to-turso.mjs --apply",
    "reconcile": "node scripts/reconcile-convex-migration.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@libsql/client": "^0.18.0",
    "pg": "^8.16.3",
    "hono": "^4.10.7",
    "jose": "^6.1.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
